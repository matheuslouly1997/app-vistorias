# ============================================================
# Variaveis publicas do Supabase (expostas ao browser)
# Combinadas com RLS sao seguras.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx_ou_eyJhbGci_xxxxx

# ============================================================
# SERVICE ROLE — server-only, NUNCA com prefixo NEXT_PUBLIC_
# Usada apenas pela API/server actions de admin (criar usuario, resetar senha).
# Vercel: adicionar em Environment Variables sem o prefixo NEXT_PUBLIC_.
# NUNCA commitar essa key em git.
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx_ou_eyJhbGci_service_xxxxx

# (opcional) Habilita PDF em deployment Vercel — requer puppeteer-core + chromium-min
# ENABLE_PDF_VERCEL=
