# Variaveis publicas do Supabase
# Estas sao seguras de expor no frontend (combinadas com RLS).
# A service_role (sb_secret_... ou JWT de service) NUNCA entra aqui.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx_ou_eyJhbGci_xxxxx

# (opcional) habilitar PDF em deployment Vercel
# Por padrao o app retorna 503 amigavel para PDF em producao Vercel
# (porque Chromium embutido nao roda em serverless). Para habilitar PDF
# em producao, voce precisaria configurar @sparticuz/chromium + puppeteer-core
# manualmente. Deixe vazio para usar Excel.
# ENABLE_PDF_VERCEL=
