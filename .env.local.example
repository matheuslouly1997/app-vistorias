# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# .env.local NUNCA vai pro git.
# IMPORTANTE: depois de editar .env.local, REINICIE o dev server (Ctrl+C e npm run dev de novo).
# Next.js NAO le envs no hot reload.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Aceita os dois formatos de key publica:
#   - JWT legado: eyJhbGci... (projetos antigos)
#   - Novo padrao 2025: sb_publishable_... (projetos novos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...ou...eyJhbGci...

# A service_role (sb_secret_... ou JWT de service) NUNCA vai aqui no frontend.
